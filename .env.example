# GuardianCam Local Hub
# Copy this file to .env before running locally or with Docker.
# Never commit a real API key.

# Application
APP_NAME=GuardianCam Home
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Deterministic fall escalation. Alert Agent/LLM never controls these values.
FALL_ESCALATION_ENABLED=true
FALL_CALL_AFTER_SECONDS=30
FALL_ESCALATION_POLL_SECONDS=2
FALL_CALL_MAX_ATTEMPTS=3
FALL_CALL_RETRY_SECONDS=10
EMERGENCY_CALL_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_NUMBER=

# Persistent storage
DATABASE_URL=sqlite:///./data/app.db
CHROMA_PERSIST_DIR=./data/chroma

# SDA integrated pipeline. Auto selects the best supported backend and reports
# any fallback explicitly.
VISION_ENGINE=sda
VISION_DEVICE=auto
VISION_NUM_POSES=1
VISION_INPUT_WIDTH=1280
VISION_INPUT_HEIGHT=720

# Identity follows the Vision lifecycle. If buffalo_l is unavailable, Identity
# reports unavailable while pose/action/fall inference keeps running.
VISION_IDENTITY_PROVIDER=auto
VISION_INSIGHTFACE_ROOT=~/.insightface

# Keep empty during normal operation. This is only for explicit mock testing.
MOCK_VISION_EVENT_FRAME_IDS=

# Optional assistant/LLM integration
GEMINI_API_KEY=
MODEL_NAME=gemini-3.5-flash-lite

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
