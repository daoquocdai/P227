# GuardianCam Local Hub
# Copy this file to .env before running locally or with Docker.
# Never commit a real API key.

# Application
APP_NAME=GuardianCam Security Orchestrator
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Persistent storage
DATABASE_URL=sqlite:///./data/app.db
CHROMA_PERSIST_DIR=./data/chroma

# SDA integrated pipeline. Auto selects the best supported backend and reports
# any fallback explicitly.
VISION_ENGINE=sda
VISION_DEVICE=auto
# Safe clone default: fall detection works without a private InsightFace model.
# Set true only after buffalo_l exists under VISION_INSIGHTFACE_ROOT.
VISION_IDENTITY_ENABLED=false
VISION_IDENTITY_PROVIDER=auto
VISION_INSIGHTFACE_ROOT=~/.insightface

# Keep empty during normal operation. This is only for explicit mock testing.
MOCK_VISION_EVENT_FRAME_IDS=

# Optional assistant/LLM integration
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
ALERT_AGENT_ENABLED=false
ALERT_AGENT_MODEL=gpt-5-mini
ALERT_AGENT_TIMEOUT_SECONDS=20
ALERT_AGENT_QUEUE_CAPACITY=32
ALERT_AGENT_MAX_ATTEMPTS=2
ALERT_AGENT_MAX_TOOL_STEPS=4
ALERT_AGENT_SHUTDOWN_TIMEOUT_SECONDS=5
UNKNOWN_INCIDENT_MERGE_SECONDS=120
FALL_INCIDENT_MERGE_SECONDS=90
ALERT_AGENT_REVIEW_MILESTONES=1,2,5,10,20,50

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
