# GuardianCam Local Hub
# Copy this file to .env before running locally or with Docker.
# Never commit a real API key.

# Application
APP_NAME=GuardianCam Security Orchestrator
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Persistent storage
DATABASE_URL=sqlite:///./data/app.db
CHROMA_PERSIST_DIR=./data/chroma

# Real Vision pipeline, CPU-only
VISION_ENGINE=legacy
VISION_DEVICE=cpu
VISION_LEGACY_YOLO_PATH=yolov8n.pt
VISION_LEGACY_CONFIG_PATH=work_dir/fall_detection/ntu25-bone/config.yaml
VISION_LEGACY_CHECKPOINT_PATH=work_dir/fall_detection/ntu25-bone/runs-best_val.pt
VISION_V2_CONFIG_PATH=work_dir/fall_detection/joint/config.yaml
VISION_V2_CHECKPOINT_PATH=work_dir/fall_detection/joint/runs-best_val.pt
VISION_LEGACY_KNOWN_FACES_DIR=register face
# Safe clone default: fall detection works without a private InsightFace model.
# Set true only after buffalo_l exists under VISION_LEGACY_INSIGHTFACE_ROOT.
VISION_LEGACY_IDENTITY_ENABLED=false
VISION_LEGACY_IDENTITY_PROVIDER=cpu
VISION_LEGACY_INSIGHTFACE_ROOT=~/.insightface
VISION_TEMPORAL_TARGET_SAMPLE_RATE=15
VISION_TEMPORAL_BUFFER_CAPACITY=8

# Keep empty during normal operation. This is only for explicit mock testing.
MOCK_VISION_EVENT_FRAME_IDS=

# Optional assistant/LLM integration
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
